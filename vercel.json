{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "schedules": {
    "after-sales-cleanup": {
      "schedule": "0 4 * * *",
      "path": "/api/cron/after-sales-cleanup",
      "requestMethod": "GET"
    },
    "order-email-outbox": {
      "schedule": "*/15 * * * *",
      "path": "/api/cron/order-email-outbox",
      "requestMethod": "GET"
    }
  }
}
